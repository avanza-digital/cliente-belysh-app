{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_USE_PRECOMPILED_MODULES": "0" }
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_USE_PRECOMPILED_MODULES": "0" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": true },
      "env": { "EXPO_USE_PRECOMPILED_MODULES": "0" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "EXPO_USE_PRECOMPILED_MODULES": "0" }
    }
  },
  "submit": {
    "production": {}
  }
}
